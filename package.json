{
  "name": "crestron-ch5-webxpanel-vue3",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --fix --ignore-path .gitignore",
    "format": "prettier --write src/",
    "fixColor": "npx run-func AlphaFixer.js fixHexRgbaColorsInScss ./dist/assets/",
    "archive": "ch5-cli archive -p crestron-ch5-webxpanel-vue3-v%npm_package_version% -d dist -o tsw",
    "build-full": "npm run build && npm run fixColor && npm run archive"
  },
  "dependencies": {
    "@crestron/ch5-crcomlib": "2.19.0",
    "@crestron/ch5-utilities-cli": "2.19.0",
    "@crestron/ch5-webxpanel": "2.8.0",
    "eruda": "3.4.3",
    "pinia": "4.0.3",
    "vue": "3.5.43",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.12.0",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/eslint-config-prettier": "10.2.0",
    "eslint": "10.11.0",
    "eslint-plugin-vue": "10.11.0",
    "prettier": "^3.9.9",
    "vite": "8.3.0"
  }
}
